# Copy this file to .env and adjust values.

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/land_records

# Where uploaded PDFs/images are stored (relative to the backend folder)
UPLOAD_DIR=uploads

# Maximum upload size in megabytes
MAX_UPLOAD_MB=20

# Insert sample land records on first start when the table is empty
SEED_SAMPLE_DATA=true

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR (Tesseract). Leave TESSERACT_CMD empty to auto-detect.
TESSERACT_CMD=
TESSDATA_DIR=tessdata
OCR_MAX_PAGES=10
OCR_DPI=300
# Fine-tuned Hindi model (falls back to stock "hin" if missing). Set to hin to use the stock model.
HINDI_OCR_MODEL=hin_landrec
# Documents OCR'd at the same time in the background (each can use several CPU cores).
OCR_WORKERS=2

# Re-run validation / conflict checks on all records at startup
RECHECK_ON_STARTUP=true

# AI field extraction with Claude (optional, off by default).
# When enabled, OCR text is sent to Anthropic's API - only use with data you may share.
AI_EXTRACTION_ENABLED=false
# Where AI runs: "anthropic" = Claude API (best accuracy; needs ANTHROPIC_API_KEY; data is sent to Anthropic)
#                "ollama"    = a vision model on this computer via Ollama (free; nothing leaves the computer;
#                              less accurate and slower). Install Ollama, then: ollama pull qwen3-vl:4b
AI_PROVIDER=anthropic
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=claude-opus-5
AI_EFFORT=low
# Also send the page images (not only the OCR text), so Claude can correct OCR misreadings.
AI_SEND_IMAGES=true
# ANTHROPIC_API_KEY=sk-ant-...
